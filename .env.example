# Groq API Configuration
GROQ_API_KEY=your_api_key_here

# Optional: Specify model (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.1-70b-versatile

# Production Checkpointing (Optional)
# Enables persistent state storage with Redis
# Development: Leave empty for in-memory checkpointing
# Production: Set to Redis URL for persistent storage
# Examples:
#   Local Redis:  redis://localhost:6379
#   Redis Cloud:  redis://user:password@host:port/db
#   Upstash:      redis://default:password@region.upstash.io:port
# REDIS_URL=redis://localhost:6379
